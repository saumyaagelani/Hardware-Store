# Copy to .env.local and adjust. Nothing here is required to run the prototype.

# Public URL of the site (used for metadata, sitemap and canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode: shows the presenter toolbar (one-click persona switching + data reset)
# and the demo credentials on the sign-in page. Set to "false" for production.
NEXT_PUBLIC_DEMO_MODE=true

# Secret used to sign session cookies. REQUIRED in production (use a long random string).
# If unset, a random per-process secret is generated (sessions reset on restart).
SESSION_SECRET=

# Where the prototype JSON data store and uploaded files are kept (default: ./.data)
DATA_DIR=

# --- Stage 2 integrations (not used by the prototype) ---
# Analytics / tracking — scripts load only when these are set
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Payments (e.g. Stripe) — never commit real keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email delivery provider (e.g. postmark | sendgrid | ses | resend)
EMAIL_PROVIDER=
EMAIL_API_KEY=
