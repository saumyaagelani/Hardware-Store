{%- comment -%}
  Basic product filters + sort for collection and search pages.
  Usage: {% render 'nl-filters', filters: collection.filters, sort_options: collection.sort_options, sort_by: collection.sort_by, reset_url: collection.url, search_terms: nil %}
  Filters shown here are the ones switched on in the free Search & Discovery app
  (Apps -> Search & Discovery -> Filters). By default Shopify offers availability and price.
{%- endcomment -%}
<form class="nl-filters" method="get" action="{{ reset_url }}">
  {%- if search_terms != blank -%}
    <input type="hidden" name="q" value="{{ search_terms | escape }}">
    <input type="hidden" name="type" value="product">
  {%- endif -%}
  <div class="nl-filters__bar">
    {%- for filter in filters -%}
      {%- assign is_open = false -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}{%- assign is_open = true -%}{%- endif -%}
      {%- elsif filter.active_values.size > 0 -%}
        {%- assign is_open = true -%}
      {%- endif -%}
      <details class="nl-filter"{% if is_open %} data-active{% endif %}>
        <summary>{{ filter.label }}{% if is_open %} <span class="nl-filter__dot" aria-hidden="true"></span>{% endif %}</summary>
        <div class="nl-filter__panel">
          {%- if filter.type == 'price_range' -%}
            <div class="nl-filter__price">
              <label>Min
                <input type="number" min="0" inputmode="decimal" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value != nil %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}" placeholder="0">
              </label>
              <label>Max
                <input type="number" min="0" inputmode="decimal" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value != nil %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}">
              </label>
            </div>
            <button type="submit" class="nl-filter__apply">Apply</button>
          {%- else -%}
            {%- for value in filter.values -%}
              <label class="nl-filter__opt{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %} onchange="this.form.submit()">
                <span>{{ value.label }}</span> <span class="nl-filter__count">({{ value.count }})</span>
              </label>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </details>
    {%- endfor -%}
    {%- if filters.size > 0 -%}
      <a class="nl-filters__clear" href="{{ reset_url }}{% if search_terms != blank %}?q={{ search_terms | url_encode }}&type=product{% endif %}">Clear filters</a>
    {%- endif -%}
    {%- if sort_options.size > 0 -%}
      <label class="nl-filters__sort">Sort by
        <select name="sort_by" onchange="this.form.submit()">
          {%- for option in sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
    {%- endif -%}
  </div>
</form>
<style>
  .nl-filters { margin: 1.25rem 0 0; }
  .nl-filters__bar { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .75rem; }
  .nl-filter { position: relative; }
  .nl-filter summary { list-style: none; display: inline-flex; align-items: center; gap: .4rem; height: 2.5rem; padding: 0 .9rem; border: 1px solid var(--nl-edge); border-radius: 6px; background: var(--nl-surface); color: var(--nl-cream); font: 600 .875rem var(--nl-font); cursor: pointer; }
  .nl-filter summary::-webkit-details-marker { display: none; }
  .nl-filter summary::after { content: ""; width: .45rem; height: .45rem; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg) translateY(-2px); }
  .nl-filter[data-active] summary { border-color: var(--nl-gold); }
  .nl-filter__dot { width: .5rem; height: .5rem; border-radius: 9999px; background: var(--nl-gold); }
  .nl-filter__panel { position: absolute; z-index: 20; top: calc(100% + .35rem); left: 0; min-width: 14rem; max-height: 18rem; overflow: auto; padding: .75rem; border: 1px solid var(--nl-edge); border-radius: 8px; background: var(--nl-surface); box-shadow: 0 18px 40px -16px rgb(0 0 0 / .5); }
  .nl-filter__opt { display: flex; align-items: center; gap: .5rem; padding: .35rem 0; font-size: .875rem; color: var(--nl-cream); cursor: pointer; }
  .nl-filter__opt.is-empty { opacity: .45; cursor: default; }
  .nl-filter__count { color: var(--nl-stone); font-size: .8125rem; }
  .nl-filter__price { display: flex; gap: .5rem; }
  .nl-filter__price label { display: grid; gap: .25rem; font-size: .8125rem; color: var(--nl-stone); }
  .nl-filter__price input { width: 6rem; height: 2.25rem; padding: 0 .5rem; border: 1px solid var(--nl-edge); border-radius: 6px; background: var(--nl-page); color: var(--nl-cream); }
  .nl-filter__apply { margin-top: .6rem; width: 100%; height: 2.25rem; border: 0; border-radius: 6px; background: var(--nl-gold); color: var(--nl-page); font: 600 .875rem var(--nl-font); cursor: pointer; }
  .nl-filters__clear { font-size: .875rem; font-weight: 600; color: var(--nl-gold); }
  .nl-filters__sort { display: flex; align-items: center; gap: .5rem; margin-left: auto; font-size: .875rem; color: var(--nl-stone); }
  .nl-filters__sort select { height: 2.5rem; padding: 0 2rem 0 .75rem; border: 1px solid var(--nl-edge); border-radius: 6px; background: var(--nl-surface); color: var(--nl-cream); font: 500 .875rem var(--nl-font); }
</style>
