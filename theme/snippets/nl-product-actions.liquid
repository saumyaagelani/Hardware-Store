{%- comment -%}
  "Request a quote" instead of buying, for:
    • products tagged  quote-only        (everyone)
    • products tagged  contractors-only  (everyone except signed-in B2B contractor customers)
  Usage: on the product template add a "Custom Liquid" block (just above Buy buttons):
    {% render 'nl-product-actions', product: product %}

  Safety: quote-only products are imported with price 0 and stock 0 / "deny", so they can't be
  bought even if this snippet is missing. Contractors-only products keep their retail price for
  regular customers; contractor prices come only from the B2B catalog, never from the theme.

  The CSS selectors below cover Shopify's Dawn and Horizon themes. If another theme is chosen,
  check the buy button still hides (see SHOPIFY_SETUP.md → Theme).
{%- endcomment -%}
{%- liquid
  assign quote_only = false
  if product.tags contains 'quote-only'
    assign quote_only = true
  elsif product.tags contains 'contractors-only'
    unless customer and customer.b2b?
      assign quote_only = true
    endunless
  endif
-%}
{%- if quote_only -%}
  <style>
    product-form, .product-form, .product-form__buttons, .product-form__input--quantity, .shopify-payment-button,
    [data-block-type="buy-buttons"], .buy-buttons-block, .product-details .price, .product__info-container .price,
    .product-information .price, .product__price, product-price, product-form-component, sticky-add-to-cart, .buy-buttons-block { display: none !important; }
  </style>
  {%- capture cat_text -%}{% render 'nl-quote-cats' %}{%- endcapture -%}
  {%- assign tag_text = product.tags | join: ' ' -%}
  {%- assign haystack = product.type | append: ' ' | append: tag_text | downcase -%}
  {%- for c in product.collections -%}{%- assign haystack = haystack | append: ' ' | append: c.title | downcase -%}{%- endfor -%}
  {%- assign match_cat = '' -%}
  {%- assign match_subs = '' -%}
  {%- assign cat_lines = cat_text | strip | newline_to_br | split: '<br />' -%}
  {%- for line in cat_lines -%}
    {%- assign parts = line | strip | split: '|' -%}
    {%- assign keys = parts[2] | split: ',' -%}
    {%- for k in keys -%}
      {%- assign key = k | strip | downcase -%}
      {%- if match_cat == '' and key != '' and haystack contains key -%}
        {%- assign match_cat = parts[0] | strip -%}
        {%- assign match_subs = parts[1] | strip -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
  {%- assign match_subs = '' -%}
  {%- assign title_lc = product.title | downcase -%}
  {%- assign title_sub = '' -%}
  {%- assign all_subs = match_subs | split: ';' -%}
  {%- for o in all_subs -%}
    {%- assign o_clean = o | strip -%}
    {%- assign o_lc = o_clean | downcase -%}
    {%- if title_sub == '' and o_lc != '' and title_lc contains o_lc -%}{%- assign title_sub = o_clean -%}{%- endif -%}
  {%- endfor -%}
  <div class="nl-quote">
    {%- if title_sub != blank -%}
      <p class="nl-quote__fixed">{{ match_cat }}: <strong>{{ title_sub }}</strong></p>
    {%- elsif match_subs != blank -%}
      {%- assign sub_list = match_subs | split: ';' -%}
      <label class="nl-quote__sub">
        <span>{{ match_cat }} — choose an option</span>
        <select data-nl-quote-sub>
          <option value="">Select an option</option>
          {%- for o in sub_list -%}<option value="{{ o | strip | escape }}">{{ o | strip }}</option>{%- endfor -%}
        </select>
      </label>
    {%- endif -%}
    <a class="button button--full-width" data-nl-quote-link data-base="{{ routes.root_url | remove_last: '/' }}/pages/quote?product={{ product.handle | url_encode }}{% if match_cat != blank %}&cat={{ match_cat | url_encode }}{% endif %}" href="{{ routes.root_url | remove_last: '/' }}/pages/quote?product={{ product.handle | url_encode }}{% if match_cat != blank %}&cat={{ match_cat | url_encode }}{% endif %}{% if title_sub != blank %}&sub={{ title_sub | url_encode }}{% endif %}">Request a quote</a>
    <p class="nl-quote__note">
      {%- if product.tags contains 'contractors-only' -%}
        Trade pricing for approved contractor accounts. <a href="{{ routes.root_url | remove_last: '/' }}/pages/contractors">Apply for a trade account</a> or request a quote.
      {%- else -%}
        Tell us your measurements and quantities — our team will send pricing, usually within one business day.
      {%- endif -%}
    </p>
  </div>
  <script>
    (() => {
      const link = document.querySelector('[data-nl-quote-link]');
      const sel = document.querySelector('[data-nl-quote-sub]');
      if (!link || !sel) return;
      sel.addEventListener('change', () => {
        link.href = link.dataset.base + (sel.value ? '&sub=' + encodeURIComponent(sel.value) : '');
      });
    })();
  </script>
  <style>.nl-quote__fixed { margin-bottom: .75rem; font-size: .9375rem; } .nl-quote__sub { display: block; margin-bottom: .75rem; } .nl-quote__sub span { display: block; margin-bottom: .35rem; font-size: .875rem; font-weight: 600; } .nl-quote__sub select { width: 100%; min-height: 2.75rem; padding: .5rem .75rem; }
  .nl-quote { margin: 1rem 0; } .nl-quote__note { margin-top: .6rem; font-size: .875rem; opacity: .8; }</style>
{%- else -%}
  <p class="nl-quote-soft"><a href="{{ routes.root_url | remove_last: '/' }}/pages/quote?product={{ product.handle | url_encode }}">Need a bulk or custom price? Request a quote</a></p>
  <style>.nl-quote-soft { margin: .75rem 0; font-size: .9375rem; } .nl-quote-soft a { text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }</style>
{%- endif -%}
