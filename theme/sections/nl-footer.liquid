{%- comment -%}
  Northline footer — recreates the prototype footer: newsletter row, brand + contact
  details, three link columns, social icons, legal row and payment methods.
{%- endcomment -%}
{%- liquid
  assign root = routes.root_url | remove_last: '/'
  assign s = section.settings
-%}
<footer class="nl-scope nl-footer">
  <div class="nl-footer__news">
    <div class="nl-container nl-footer__news-row">
      <div>
        <p class="nl-footer__news-title">{{ s.news_title }}</p>
        <p class="nl-footer__news-sub">{{ s.news_sub }}</p>
      </div>
      {%- form 'customer', class: 'nl-footer__form', id: 'nl-footer-newsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="nl-footer__ok" role="status">Thanks — you're subscribed.</p>
        {%- else -%}
          <input type="email" name="contact[email]" required autocomplete="email" placeholder="Your email address" aria-label="Email address">
          <button type="submit">Subscribe</button>
        {%- endif -%}
        {%- if form.errors -%}<p class="nl-footer__err">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endform -%}
    </div>
  </div>

  <div class="nl-container nl-footer__grid">
    <div>
      <a href="{{ routes.root_url }}" class="nl-logo" aria-label="{{ s.brand_name | escape }} — home">
        <svg viewBox="0 0 40 40" class="nl-logo__mark" aria-hidden="true"><rect width="40" height="40" rx="6" fill="#F5B82E"/><path d="M8 19 20 9l12 10" fill="none" stroke="#1D211C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 31V20l14 11V20" fill="none" stroke="#1D211C" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="nl-logo__text">
          <span class="nl-logo__name">{{ s.brand_short }}</span>
          <span class="nl-logo__sub">{{ s.brand_sub }}</span>
        </span>
      </a>
      <p class="nl-footer__tagline">{{ s.tagline }}</p>
      <ul class="nl-footer__contact">
        {%- if s.address != blank -%}<li>{% render 'nl-icon', name: 'map-pin', size: 16 %}<span>{{ s.address }}</span></li>{%- endif -%}
        {%- if s.phone != blank -%}<li>{% render 'nl-icon', name: 'phone', size: 16 %}<a href="tel:{{ s.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ s.phone }}</a></li>{%- endif -%}
        {%- if s.email != blank -%}<li>{% render 'nl-icon', name: 'mail', size: 16 %}<a href="mailto:{{ s.email }}">{{ s.email }}</a></li>{%- endif -%}
        {%- if s.hours != blank -%}<li>{% render 'nl-icon', name: 'clock', size: 16 %}<span>{{ s.hours | newline_to_br }}</span></li>{%- endif -%}
      </ul>
    </div>

    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h2 class="nl-footer__col-title">{{ block.settings.title }}</h2>
        {%- assign menu = linklists[block.settings.menu] -%}
        <ul class="nl-footer__links">
          {%- if menu.links.size > 0 -%}
            {%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          {%- else -%}
            {%- assign lines = block.settings.links | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign parts = line | strip | split: '|' -%}
              {%- if parts.size == 2 -%}<li><a href="{{ parts[1] | strip }}">{{ parts[0] | strip }}</a></li>{%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
        {%- if forloop.last -%}
          <div class="nl-footer__social">
            {%- if s.facebook != blank -%}<a href="{{ s.facebook }}" aria-label="Facebook"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v7h4v-7H16l.5-4h-3V8.8c0-.5.3-.8.5-.8Z"/></svg></a>{%- endif -%}
            {%- if s.instagram != blank -%}<a href="{{ s.instagram }}" aria-label="Instagram"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="nl-footer__legal">
    <div class="nl-container nl-footer__legal-row">
      <div class="nl-footer__legal-links">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ s.brand_name }}</span>
        {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{%- endif -%}
        {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">Terms</a>{%- endif -%}
        {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">Returns</a>{%- endif -%}
        {%- if shop.shipping_policy -%}<a href="{{ shop.shipping_policy.url }}">Shipping</a>{%- endif -%}
      </div>
      <ul class="nl-footer__pay" aria-label="Payment methods">
        {%- assign methods = s.payment_labels | split: ',' -%}
        {%- for m in methods -%}<li>{{ m | strip }}</li>{%- endfor -%}
      </ul>
    </div>
  </div>
</footer>

<style>
  .nl-footer { background: var(--nl-page); color: var(--nl-cream); margin-top: auto; }
  .nl-footer__news { border-bottom: 1px solid var(--nl-edge); }
  .nl-footer__news-row { display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; gap: 1.5rem; padding-block: 2.5rem; }
  @media (min-width: 1024px) { .nl-footer__news-row { flex-direction: row; align-items: center; } }
  .nl-footer__news-title { font-size: 1.5rem; font-weight: 700; }
  .nl-footer__news-sub { margin-top: .25rem !important; font-size: .875rem; color: rgb(243 241 233 / .7); }
  .nl-footer__form { display: flex; width: 100%; max-width: 28rem; flex-wrap: wrap; }
  .nl-footer__form input[type="email"] { flex: 1; min-width: 0; height: 2.75rem; border: 1px solid var(--nl-edge); border-right: 0; border-radius: 6px 0 0 6px; background: var(--nl-surface); color: var(--nl-cream); padding: 0 .875rem; font-size: .9375rem; }
  .nl-footer__form input::placeholder { color: var(--nl-stone); }
  .nl-footer__form button { height: 2.75rem; padding: 0 1.1rem; border: 0; border-radius: 0 6px 6px 0; background: var(--nl-gold); color: var(--nl-page); font: 600 .9375rem var(--nl-font); cursor: pointer; }
  .nl-footer__form button:hover { opacity: .9; }
  .nl-footer__ok { color: var(--nl-success); font-weight: 600; }
  .nl-footer__err { width: 100%; margin-top: .4rem !important; color: #ef9a8f; font-size: .8125rem; }

  .nl-footer__grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; padding-block: 3rem; }
  @media (min-width: 640px) { .nl-footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .nl-footer__grid { grid-template-columns: 1.4fr 1fr 1fr 1fr; } }
  .nl-footer__tagline { margin-top: 1rem !important; max-width: 20rem; font-size: .875rem; line-height: 1.6; color: rgb(243 241 233 / .7); }
  .nl-footer__contact { margin-top: 1.5rem !important; display: grid; gap: .75rem; font-size: .875rem; color: rgb(243 241 233 / .8); }
  .nl-footer__contact li { display: flex; gap: .625rem; }
  .nl-footer__contact svg { margin-top: .15rem; color: var(--nl-gold); }
  .nl-footer__contact a:hover { color: var(--nl-gold); }
  .nl-footer__col-title { margin-bottom: 1rem !important; font-size: .875rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .nl-footer__links { display: grid; gap: .625rem; }
  .nl-footer__links a { font-size: .875rem; color: rgb(243 241 233 / .7); }
  .nl-footer__links a:hover { color: var(--nl-gold); }
  .nl-footer__social { display: flex; gap: .5rem; margin-top: 2rem; }
  .nl-footer__social a { display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; border-radius: 6px; background: var(--nl-surface-2); color: rgb(243 241 233 / .8); }
  .nl-footer__social a:hover { background: var(--nl-gold); color: var(--nl-page); }
  .nl-footer__legal { border-top: 1px solid var(--nl-edge); }
  .nl-footer__legal-row { display: flex; flex-direction: column; gap: 1rem; padding-block: 1.5rem; font-size: .75rem; color: rgb(243 241 233 / .6); }
  @media (min-width: 768px) { .nl-footer__legal-row { flex-direction: row; align-items: center; justify-content: space-between; } }
  .nl-footer__legal-links { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem 1rem; }
  .nl-footer__legal-links a:hover { color: var(--nl-cream); }
  .nl-footer__pay { display: flex; flex-wrap: wrap; gap: .5rem; }
  .nl-footer__pay li { padding: .3rem .6rem; border-radius: 4px; background: var(--nl-surface-2); color: var(--nl-cream); font-weight: 600; font-size: .6875rem; }
</style>

{% schema %}
{
  "name": "Northline footer",
  "settings": [
    { "type": "text", "id": "news_title", "label": "Newsletter heading", "default": "Get deals & new-product news" },
    { "type": "text", "id": "news_sub", "label": "Newsletter text", "default": "Occasional emails only. Unsubscribe anytime." },
    { "type": "text", "id": "brand_short", "label": "Brand name", "default": "Northline" },
    { "type": "text", "id": "brand_sub", "label": "Brand subtitle", "default": "Building Supply" },
    { "type": "text", "id": "brand_name", "label": "Full business name", "default": "Northline Building Supply" },
    { "type": "textarea", "id": "tagline", "label": "About text", "default": "Flooring, doors & bath — supplied right. Serving homeowners and trade professionals with in-store pickup and local delivery." },
    { "type": "text", "id": "address", "label": "Address", "default": "100 Placeholder Avenue, Unit 4, Your City, ON A1A 1A1" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "(555) 010-0142" },
    { "type": "text", "id": "email", "label": "Email", "default": "sales@example.com" },
    { "type": "textarea", "id": "hours", "label": "Opening hours (one per line)", "default": "Monday – Friday: 7:30 am – 6:00 pm\nSaturday: 8:00 am – 4:00 pm\nSunday: Closed" },
    { "type": "url", "id": "facebook", "label": "Facebook link" },
    { "type": "url", "id": "instagram", "label": "Instagram link" },
    { "type": "text", "id": "payment_labels", "label": "Payment methods (comma separated)", "default": "Visa, Mastercard, Amex, Apple Pay, Google Pay, Interac e-Transfer" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu (optional)" },
        { "type": "textarea", "id": "links", "label": "Links when no menu is chosen (one per line: Label | /url)" }
      ]
    }
  ]
}
{% endschema %}
