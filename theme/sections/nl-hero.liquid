{%- comment -%} Homepage hero — same layout as the prototype: text panel left, image right with a caption and a link card. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="nl-scope nl-hero">
  <div class="nl-hero__grid">
    <div class="nl-hero__copy">
      <p class="nl-hero__eyebrow"><span aria-hidden="true"></span>{{ s.eyebrow }}</p>
      <h1 class="nl-hero__title">
        <span>{{ s.title_lead }}</span>
        {%- if s.title_accent != blank -%}<span class="nl-hero__accent">{{ s.title_accent }}</span>{%- endif -%}
      </h1>
      <p class="nl-hero__body">{{ s.body }}</p>
      <div class="nl-hero__btns">
        {%- if s.btn1_label != blank -%}<a href="{{ s.btn1_link | default: routes.all_products_collection_url }}" class="nl-btn nl-btn--gold nl-hero__btn">{{ s.btn1_label }} {% render 'nl-icon', name: 'arrow-up-right', size: 20 %}</a>{%- endif -%}
        {%- if s.btn2_label != blank -%}<a href="{{ s.btn2_link | default: '/pages/quote' }}" class="nl-btn nl-btn--outline nl-hero__btn">{{ s.btn2_label }}</a>{%- endif -%}
      </div>
      <div class="nl-hero__strip">
        <p class="nl-hero__strip-a">{{ s.strip_a }}</p>
        <p class="nl-hero__strip-b">{{ s.strip_b }}</p>
      </div>
    </div>
    <div class="nl-hero__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', alt: s.image.alt, class: 'nl-hero__img', sizes: '(min-width: 1024px) 48vw, 100vw', widths: '600, 900, 1200, 1600' }}
      {%- else -%}
        <img src="{{ 'nl-hero.svg' | asset_url }}" alt="Illustration of a finished interior with vinyl plank flooring, a fluted wall panel feature wall, a Shaker door and a navy vanity" class="nl-hero__img" fetchpriority="high" width="1200" height="800">
      {%- endif -%}
      <div class="nl-hero__shade" aria-hidden="true"></div>
      {%- if s.caption != blank -%}<p class="nl-hero__caption">{{ s.caption }}</p>{%- endif -%}
      {%- if s.card_title != blank -%}
        <a href="{{ s.card_link | default: routes.all_products_collection_url }}" class="nl-hero__card">
          <span class="nl-hero__card-eyebrow">{{ s.card_eyebrow }}</span>
          <span class="nl-hero__card-title">{{ s.card_title }} {% render 'nl-icon', name: 'arrow-up-right', size: 26 %}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .nl-hero { --u: clamp(0.64px, 0.0625vw, 1.2px); position: relative; overflow: hidden; border-top: 1px solid var(--nl-edge); background: var(--nl-surface); color: var(--nl-cream); }
  .nl-hero__grid { display: grid; grid-template-columns: 1fr; }
  .nl-hero__copy { display: flex; flex-direction: column; padding: 3rem 1rem 2.5rem; }
  @media (min-width: 640px) { .nl-hero__copy { padding: 4rem 1.5rem 3rem; } }
  .nl-hero__eyebrow { display: flex; align-items: center; gap: .75rem; font-size: .75rem; line-height: 1; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  @media (min-width: 640px) { .nl-hero__eyebrow { font-size: .875rem; } }
  .nl-hero__eyebrow span { display: block; width: 2rem; height: 2px; background: var(--nl-gold); flex-shrink: 0; }
  .nl-hero__title { margin-top: 1.5rem !important; max-width: 10em; font-size: 2.625rem; line-height: .98; font-weight: 500; letter-spacing: -0.035em; color: var(--nl-cream); }
  @media (min-width: 640px) { .nl-hero__title { margin-top: 2rem !important; font-size: 3.5rem; } }
  .nl-hero__title span { display: block; }
  .nl-hero__accent { color: var(--nl-gold); }
  .nl-hero__body { margin-top: 1.25rem !important; max-width: 36rem; font-size: 1rem; line-height: 1.65; color: #9ca3af; }
  @media (min-width: 640px) { .nl-hero__body { margin-top: 1.75rem !important; font-size: 1.125rem; } }
  .nl-hero__btns { display: flex; flex-direction: column; gap: .75rem; margin-top: 2rem; }
  @media (min-width: 640px) { .nl-hero__btns { flex-direction: row; } }
  .nl-hero__strip { display: flex; flex-direction: column; gap: .375rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--nl-edge); }
  @media (min-width: 640px) { .nl-hero__strip { flex-direction: row; flex-wrap: wrap; align-items: baseline; column-gap: 1.5rem; } }
  .nl-hero__strip-a { font-size: .75rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  @media (min-width: 640px) { .nl-hero__strip-a { font-size: .875rem; } }
  .nl-hero__strip-b { font-size: .875rem; color: #9ca3af; white-space: nowrap; }
  @media (min-width: 640px) { .nl-hero__strip-b { font-size: 1rem; } }

  .nl-hero__media { position: relative; aspect-ratio: 4 / 3; }
  @media (min-width: 640px) { .nl-hero__media { aspect-ratio: 16 / 10; } }
  .nl-hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 60%; }
  .nl-hero__shade { position: absolute; inset: 0; background: linear-gradient(to bottom, rgb(29 33 28 / .4), transparent 50%); }
  .nl-hero__caption { position: absolute; top: 1.25rem; left: 1.25rem; font-size: .875rem; color: #fff; }
  @media (min-width: 640px) { .nl-hero__caption { top: 1.75rem; left: 2rem; } }
  .nl-hero__card { position: absolute; right: 1.25rem; bottom: 1.25rem; left: 1.25rem; display: block; background: var(--nl-cream); color: var(--nl-inverse) !important; padding: 1rem 1.25rem 1.25rem; box-shadow: 0 10px 30px -12px rgb(0 0 0 / .35); }
  @media (min-width: 640px) { .nl-hero__card { right: auto; bottom: 2rem; left: 2rem; width: 26rem; } }
  .nl-hero__card-eyebrow { display: block; font-size: .6875rem; line-height: 1; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; color: rgb(32 41 28 / .7); }
  .nl-hero__card-title { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: .75rem; font-size: 1.5rem; line-height: 1.1; letter-spacing: -0.01em; }
  .nl-hero__card:hover svg { transform: translate(2px, -2px); }
  .nl-hero__card svg { transition: transform .2s; }

  @media (min-width: 1024px) {
    .nl-hero__grid { grid-template-columns: 52.75fr 47.25fr; min-height: calc(900 * var(--u)); }
    .nl-hero__copy { padding: calc(159 * var(--u)) calc(41 * var(--u)) calc(110 * var(--u)) calc(84 * var(--u)); }
    .nl-hero__eyebrow { margin-left: calc(-6 * var(--u)); gap: calc(21 * var(--u)); font-size: max(12px, calc(20.5 * var(--u))); }
    .nl-hero__eyebrow span { width: calc(44 * var(--u)); height: max(1.5px, calc(2 * var(--u))); }
    .nl-hero__title { margin-top: calc(47 * var(--u)) !important; margin-left: calc(-3 * var(--u)); font-size: calc(82 * var(--u)); line-height: calc(80.5 * var(--u)); }
    .nl-hero__body { margin-top: calc(32 * var(--u)) !important; max-width: calc(720 * var(--u)); font-size: max(16px, calc(22 * var(--u))); line-height: max(24px, calc(34 * var(--u))); }
    .nl-hero__btns { margin-top: calc(41 * var(--u)); margin-left: calc(7 * var(--u)); gap: calc(21 * var(--u)); }
    .nl-hero__btn { min-height: max(44px, calc(62 * var(--u))); padding-inline: calc(31 * var(--u)); font-size: max(15px, calc(21 * var(--u))); }
    .nl-hero__strip { margin-top: calc(53 * var(--u)); padding-top: calc(38 * var(--u)); column-gap: calc(25 * var(--u)); }
    .nl-hero__strip-a { font-size: max(12px, calc(18 * var(--u))); line-height: 1.2; }
    .nl-hero__strip-b { font-size: max(13px, calc(19 * var(--u))); line-height: 1.2; }
    .nl-hero__media { aspect-ratio: auto; }
    .nl-hero__caption { top: calc(71 * var(--u)); left: calc(46 * var(--u)); font-size: max(13px, calc(19 * var(--u))); line-height: 1.3; }
    .nl-hero__card { bottom: calc(102 * var(--u)); left: calc(46 * var(--u)); width: calc(562 * var(--u)); padding: calc(28 * var(--u)) calc(34 * var(--u)) calc(30 * var(--u)); }
    .nl-hero__card-eyebrow { font-size: max(10px, calc(16 * var(--u))); }
    .nl-hero__card-title { margin-top: calc(14 * var(--u)); font-size: max(20px, calc(36 * var(--u))); }
  }
</style>

{% schema %}
{
  "name": "Northline hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Your foundation for a better home" },
    { "type": "text", "id": "title_lead", "label": "Heading (white)", "default": "Quality building supplies." },
    { "type": "text", "id": "title_accent", "label": "Heading (gold)", "default": "Better prices." },
    { "type": "textarea", "id": "body", "label": "Text", "default": "Flooring, interior doors, tiles and bathroom essentials. Thoughtfully selected for the spaces you live in and the projects you build." },
    { "type": "text", "id": "btn1_label", "label": "Gold button", "default": "Shop products" },
    { "type": "url", "id": "btn1_link", "label": "Gold button link" },
    { "type": "text", "id": "btn2_label", "label": "Outline button", "default": "Get a free quote" },
    { "type": "url", "id": "btn2_link", "label": "Outline button link" },
    { "type": "text", "id": "strip_a", "label": "Bottom line (bold)", "default": "For homeowners & professionals" },
    { "type": "text", "id": "strip_b", "label": "Bottom line", "default": "Canadian projects. Covered." },
    { "type": "image_picker", "id": "image", "label": "Image (optional — the illustration is used when empty)" },
    { "type": "text", "id": "caption", "label": "Image caption", "default": "A good home starts with a great foundation." },
    { "type": "text", "id": "card_eyebrow", "label": "Link card small text", "default": "Natural textures. Lasting impressions." },
    { "type": "text", "id": "card_title", "label": "Link card title", "default": "Explore vinyl flooring" },
    { "type": "url", "id": "card_link", "label": "Link card link" }
  ],
  "presets": [{ "name": "Northline hero" }]
}
{% endschema %}
